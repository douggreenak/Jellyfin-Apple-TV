#!/bin/bash
#
# pre-push — before code leaves this machine, rebuild builds/Jellyfin.ipa if
# the push includes any change under Jellyfin/ (the tvOS app), and fold the
# refreshed IPA — plus a freshly generated app-version reference file and
# bumped web app package.json versions (see build-ipa.sh) — into a new commit
# so what gets pushed always matches what's in builds/.
#
# Installed via (one-time, per clone):
#   git config core.hooksPath scripts/git-hooks
#
# Skip once with: git push --no-verify
# Uninstall with:  git config --unset core.hooksPath

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$REPO_ROOT"

ZERO_SHA="0000000000000000000000000000000000000000"
EMPTY_TREE="$(git hash-object -t tree /dev/null)"
NEEDS_BUILD=0

# stdin lines: "<local-ref> <local-sha> <remote-ref> <remote-sha>"
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO_SHA" ] && continue # this ref is being deleted, nothing to build

  base="$remote_sha"
  [ "$base" = "$ZERO_SHA" ] && base="$EMPTY_TREE" # brand-new remote branch: diff from nothing

  if ! git diff --quiet "$base" "$local_sha" -- Jellyfin/ 2>/dev/null; then
    NEEDS_BUILD=1
  fi
done

if [ "$NEEDS_BUILD" -eq 0 ]; then
  exit 0
fi

echo "pre-push: Jellyfin/ changed since the last push — rebuilding builds/Jellyfin.ipa…"

if ! "$REPO_ROOT/scripts/build-ipa.sh"; then
  echo "pre-push: IPA build FAILED — aborting push so a stale/missing IPA doesn't go out." >&2
  echo "pre-push: fix the build and push again, or run 'git push --no-verify' to skip this check." >&2
  exit 1
fi

GENERATED_PATHS=(
  builds/Jellyfin.ipa
  management-server/server/latest-app-version.json
  management-server/server/package.json
  management-server/admin/package.json
)

# Stage first, then check the STAGED diff — latest-app-version.json is
# untracked on its very first run ever, and plain `git diff` (unstaged) never
# sees untracked files, so checking before staging would wrongly conclude
# "nothing changed" that first time.
git add -- "${GENERATED_PATHS[@]}"
if git diff --cached --quiet -- "${GENERATED_PATHS[@]}"; then
  echo "pre-push: generated files unchanged, nothing to commit."
  exit 0
fi

git commit --no-verify -m "Auto-update built IPA + version numbers

Rebuilt by scripts/git-hooks/pre-push because Jellyfin/ changed: refreshed
builds/Jellyfin.ipa, the fleet's latest-app-version.json, and bumped both
web app package.json versions — all from the same git commit count.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>"

echo "pre-push: committed refreshed build artifacts — they will be included in this push."
exit 0
